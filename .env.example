# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; Kimi sign-in for this id gets role "admin"
OWNER_GITHUB_ID=          # GitHub numeric account id of the owner; not a member allowlist

# ── GitHub sign-in (server only; leave empty to disable the provider) ──
GITHUB_CLIENT_ID=         # GitHub OAuth app client id
GITHUB_CLIENT_SECRET=     # GitHub OAuth app client secret
GITHUB_OAUTH_REDIRECT_URL= # Exact callback, e.g. https://app.bertapp.life/api/oauth/callback
GITHUB_WEBHOOK_SECRET=    # GitHub webhook HMAC secret (Environment github / host only)

# ── Server-side AI gateway (never expose to the browser) ───────
KIMI_AGENTGW_API_KEY=     # Per-owner gateway credential
KIMI_AGENTGW_BASE_URL=    # Gateway URL, including the /coding/v1 suffix

# ── Platform object storage (server-side, for generated media) ──
KIMI_STORAGE_RESOURCE_ID= # Storage resource ID injected by the platform (not a secret)

# ── Plugins / WeChat (host only; this build ignores the values and does not connect) ──
WECHAT_ADAPTER=            # Leave unset. A later build accepts only "enabled"
PLUGIN_HOOKS_ENABLED=      # Leave unset. Outbound hook delivery is not shipped
WECHAT_APP_ID=             # Official Account app id, or WeCom corp id
WECHAT_APP_SECRET=         # Server only
WECHAT_TOKEN=              # Callback signature token. Server only
WECHAT_ENCODING_AES_KEY=   # Official encrypted-message key. Server only
